# Copiar a /etc/historias.env (chmod 600). NO subir el archivo real a GitHub.
SECRET_KEY=GENERA_UNA_CLAVE_LARGA_Y_ALEATORIA
DEBUG=False
ALLOWED_HOSTS=DNS_DEL_ALB
CSRF_TRUSTED_ORIGINS=http://DNS_DEL_ALB
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://DNS_DEL_ALB

# RDS (subred privada de datos)
DB_NAME=historias
DB_USER=historias_admin
DB_PASSWORD=LA_CONTRASEÑA
DB_HOST=ENDPOINT_DE_RDS

# Admin inicial (lo crea deploy/bootstrap.sh la primera vez)
ADMIN_EMAIL=admin@medicampus.local
ADMIN_PASSWORD=CAMBIA_ESTA_CLAVE

# Opcionales: se activan cuando el rol IAM tenga permisos
# AWS_REGION=us-east-2
# AWS_STORAGE_BUCKET_NAME=NOMBRE_DEL_BUCKET_S3
# EMAIL_BACKEND=django_ses.SESBackend
# DEFAULT_FROM_EMAIL=MediCampus <correo-verificado-en-ses@dominio>

# Datos de demostración (solo para la entrega)
# DJANGO_SEED_DATA=true
